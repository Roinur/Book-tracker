<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingTop="8dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="3dp">
        <ImageView android:id="@+id/goal_daily_ring" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/goal_daily_label" style="@style/BookGoalNotificationLabel" />
        <TextView android:id="@+id/goal_daily_value" style="@style/BookGoalNotificationValue" />
        <TextView android:id="@+id/goal_daily_unit" style="@style/BookGoalNotificationDetail" />
        <TextView android:id="@+id/goal_daily_remaining" style="@style/BookGoalNotificationDetail" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="3dp">
        <ImageView android:id="@+id/goal_monthly_ring" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/goal_monthly_label" style="@style/BookGoalNotificationLabel" />
        <TextView android:id="@+id/goal_monthly_value" style="@style/BookGoalNotificationValue" />
        <TextView android:id="@+id/goal_monthly_unit" style="@style/BookGoalNotificationDetail" />
        <TextView android:id="@+id/goal_monthly_remaining" style="@style/BookGoalNotificationDetail" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="3dp">
        <ImageView android:id="@+id/goal_yearly_ring" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginBottom="8dp" />
        <TextView android:id="@+id/goal_yearly_label" style="@style/BookGoalNotificationLabel" />
        <TextView android:id="@+id/goal_yearly_value" style="@style/BookGoalNotificationValue" />
        <TextView android:id="@+id/goal_yearly_unit" style="@style/BookGoalNotificationDetail" />
        <TextView android:id="@+id/goal_yearly_remaining" style="@style/BookGoalNotificationDetail" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
